+//
+// Put the UFS stream in S2 bypass, for the OS that starts next.
+//
+// HALIOMMU leaves every stream it configured on a translation context bank that
+// it then disables (SCTLR = 0), so after ExitBootServices nothing the UFS
+// controller issues is answered: the doorbell reads set, IS stays clear and no
+// descriptor is ever fetched. The kernel cannot repair that - one S2CR store
+// from there resets this part - while firmware can, and firmware is where
+// HALIOMMU writes the same registers.
+//
+// The store follows arm_smmu_write_sme(): the stream-match entry is invalidated
+// first, the S2CR is written while nothing matches it, the entry is made valid
+// again, and the context bank's TLB is flushed. Writing S2CR while the entry is
+// valid asks the SMMU to change the routing of a stream that may have
+// transactions in flight, which the architecture does not define.
+//
+// Stream 0x60 is the UFS host (ufshc@1d84000 iommus = <&apps_smmu 0x60 0>).
+//
+// This runs after the payload has been read from the partition: until then
+// UEFI's own UFS driver uses the translated IOVAs through that bank.
+//
+STATIC
+VOID
+PianoSmmuUfsBypass (
+  VOID
+  )
+{
+  volatile UINT32  *Smmu;
+  UINT32            Id0;
+  UINT32            Id1;
+  UINT32            NumSmrg;
+  UINT32            PageShift;
+  UINT32            NumPage;
+  UINT32            Index;
+
+  Smmu      = (volatile UINT32 *)(UINTN)0x15000000;
+  Id0       = Smmu[0x20 / 4];               // GR0_ID0
+  Id1       = Smmu[0x24 / 4];               // GR0_ID1
+  NumSmrg   = Id0 & 0xFF;                   // NUMSMRG
+  PageShift = ((Id1 & 0x80000000U) != 0) ? 16 : 12;
+  NumPage   = 1U << (((Id1 >> 28) & 0x7) + 1);
+
+  for (Index = 0; Index < NumSmrg; Index++) {
+    UINT32 Smr  = Smmu[(0x800 + 4 * Index) / 4];
+    UINT32 S2cr = Smmu[(0xC00 + 4 * Index) / 4];
+    UINT32 Bank;
+    UINT32 Spin;
+
+    if (((Smr & 0x80000000U) == 0) || ((Smr & 0xFFFF) != 0x60)) {
+      continue;
+    }
+
+    Bank = S2cr & 0xFF;
+
+    // 1. invalidate the entry so nothing matches the stream while S2CR changes
+    Smmu[(0x800 + 4 * Index) / 4] = Smr & ~0x80000000U;
+    __asm__ volatile ("dsb sy" ::: "memory");
+
+    // 2. bypass: the controller's own physical addresses are what the SMMU uses
+    Smmu[(0xC00 + 4 * Index) / 4] = 2U << 16;
+    __asm__ volatile ("dsb sy" ::: "memory");
+
+    // 3. re-enable the entry
+    Smmu[(0x800 + 4 * Index) / 4] = Smr | 0x80000000U;
+    __asm__ volatile ("dsb sy" ::: "memory");
+
+    // 4. drop whatever the context bank cached for this stream
+    {
+      volatile UINT32 *Cb = Smmu + ((NumPage + Bank) << PageShift);
+      Cb[0x618 / 4] = 0;                    // TLBIALL
+      Cb[0x7F0 / 4] = 0;                    // TLBSYNC
+      for (Spin = 0; Spin < 100000; Spin++) {
+        if ((Cb[0x7F4 / 4] & 1) == 0) {
+          break;
+        }
+      }
+    }
+    __asm__ volatile ("dsb sy" ::: "memory");
+
+    Print (L"piano: UFS stream %u to bypass (smr=%08x s2cr was %08x bank %u)\r\n", Index, Smr, S2cr, Bank);
+    return;
+  }
+
+  Print (L"piano: no valid SMMU entry for stream 0x60 (id0=%08x)\r\n", Id0);
+}
+
 EFI_DEVICE_PATH_PROTOCOL**
