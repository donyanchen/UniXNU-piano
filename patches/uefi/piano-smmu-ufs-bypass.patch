+//
+// Turn the SMMU off for the OS that starts next.
+//
+// The UFS stream's own S2CR cannot be rewritten here - a single store resets
+// the board - so this variant takes the coarser route: clear SCR0.SMMUEN, which
+// makes every client bypass the SMMU. Physical addresses then reach memory
+// unchanged, which is what the controller hands it anyway.
+//
+// Stream 0x60 is the UFS host (ufshc@1d84000 iommus = <&apps_smmu 0x60 0>).
+// This runs after the payload has been read from the partition.
+//
+STATIC
+VOID
+PianoSmmuUfsBypass (
+  VOID
+  )
+{
+  volatile UINT32  *Smmu;
+  UINT32            Scr0;
+
+  Smmu = (volatile UINT32 *)(UINTN)0x15000000;
+  Scr0 = Smmu[0x00 / 4];                    // GR0_sCR0
+  Print (L"piano: scr0 was %08x\r\n", Scr0);
+
+  Smmu[0x00 / 4] = Scr0 & ~1U;              // SMMUEN = 0: every client bypasses
+  __asm__ volatile ("dsb sy" ::: "memory");
+
+  Print (L"piano: scr0 now %08x\r\n", Smmu[0x00 / 4]);
+}
+
 EFI_DEVICE_PATH_PROTOCOL**
 EFIAPI
 DeviceBootManagerAfterConsole ()
@@ -173,6 +203,8 @@ DeviceBootManagerAfterConsole ()
   // twenty-second window made every attempt a race with the enumeration.
   PianoFastbootWaitPayload (180000);
 
+  PianoSmmuUfsBypass ();
