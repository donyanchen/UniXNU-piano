+//
+// Probe the SMMU before the OS starts, and put the UFS stream in bypass if the
+// block answers at all.
+//
+// A single S2CR store resets the board from the kernel, and the firmware
+// attempt crashed with a synchronous exception before its first Print, so the
+// open question is whether the whole block is unreachable by then. Every step
+// prints before it touches the next register, so the next screen says how far
+// it got.
+//
+STATIC
+VOID
+PianoSmmuUfsBypass (
+  VOID
+  )
+{
+  volatile UINT32  *Smmu;
+  UINT32            Scr0;
+  UINT32            Id0;
+  UINT32            Index;
+  UINT32            NumSmrg;
+
+  Print (L"piano: smmu probe start\r\n");
+  Smmu = (volatile UINT32 *)(UINTN)0x15000000;
+
+  Scr0 = Smmu[0x00 / 4];
+  Print (L"piano: smmu scr0=%08x\r\n", Scr0);
+
+  Id0 = Smmu[0x20 / 4];
+  Print (L"piano: smmu id0=%08x\r\n", Id0);
+
+  NumSmrg = Id0 & 0xFF;
+  if ((NumSmrg == 0) || (NumSmrg > 128)) {
+    Print (L"piano: smmu id0 unusable, giving up\r\n");
+    return;
+  }
+
+  for (Index = 0; Index < NumSmrg; Index++) {
+    UINT32 Smr = Smmu[(0x800 + 4 * Index) / 4];
+
+    if (((Smr & 0x80000000U) == 0) || ((Smr & 0xFFFF) != 0x60)) {
+      continue;
+    }
+
+    Print (L"piano: smmu stream %u smr=%08x s2cr=%08x\r\n",
+           Index, Smr, Smmu[(0xC00 + 4 * Index) / 4]);
+
+    Smmu[(0x800 + 4 * Index) / 4] = Smr & ~0x80000000U;
+    __asm__ volatile ("dsb sy" ::: "memory");
+    Smmu[(0xC00 + 4 * Index) / 4] = 2U << 16;
+    __asm__ volatile ("dsb sy" ::: "memory");
+    Smmu[(0x800 + 4 * Index) / 4] = Smr | 0x80000000U;
+    __asm__ volatile ("dsb sy" ::: "memory");
+
+    Print (L"piano: smmu s2cr now %08x\r\n", Smmu[(0xC00 + 4 * Index) / 4]);
+    return;
+  }
+
+  Print (L"piano: smmu no stream 0x60 among %u entries\r\n", NumSmrg);
+}
+
 EFI_DEVICE_PATH_PROTOCOL**
 EFIAPI
 DeviceBootManagerAfterConsole ()
