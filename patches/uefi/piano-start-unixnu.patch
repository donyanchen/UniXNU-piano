@@ -73,7 +75,19 @@ STATIC EFI_GUID  mAndroidBootFileGuid = {
   0x2F6C1A4E, 0x8B3D, 0x4C57, { 0xA1, 0xE9, 0x6D, 0x0B, 0x7F, 0x3C, 0x5A, 0x21 }
 };
 
-// Start an application from our own firmware volume by its file GUID.
+// UniXNU.efi in the firmware volume (FILE_GUID in UniXNUPkg/Application/UniXNU).
+STATIC EFI_GUID  mUniXNUFileGuid = {
+  0x9B665204, 0xA133, 0x47A2, { 0x93, 0x96, 0x9E, 0x2B, 0x37, 0x0A, 0x4E, 0x25 }
+};
+
+// Start an application from a firmware volume by its file GUID.
+//
+// The old version built the path from DevicePathFromHandle
+// (LoadedImage->DeviceHandle). Inside BDS that handle does not carry a usable
+// firmware volume path, so the resulting device path was incomplete and
+// EfiBootManagerBoot failed silently; the boot then fell through to the UEFI
+// Shell. Read the PE image out of the volume and load it directly instead,
+// and report every outcome on the console while the board is being brought up.
 STATIC
 VOID
 StartFvApp (
@@ -81,31 +95,30 @@ StartFvApp (
   IN CHAR16    *Name
   )
 {
-  EFI_STATUS                         Status;
-  EFI_LOADED_IMAGE_PROTOCOL         *LoadedImage;
-  MEDIA_FW_VOL_FILEPATH_DEVICE_PATH  FileNode;
-  EFI_DEVICE_PATH_PROTOCOL          *DevicePath;
-  EFI_BOOT_MANAGER_LOAD_OPTION       Option;
-
-  Status = gBS->HandleProtocol (gImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&LoadedImage);
+  EFI_STATUS  Status;
+  VOID        *Buffer;
+  UINTN       Size;
+  EFI_HANDLE  Image;
+
+  Buffer = NULL;
+  Size   = 0;
+  Status = GetSectionFromAnyFv (FileGuid, EFI_SECTION_PE32, 0, &Buffer, &Size);
   if (EFI_ERROR (Status)) {
+    Print (L"piano: %s: not in any firmware volume (%r)\n", Name, Status);
     return;
   }
 
-  EfiInitializeFwVolDevicepathNode (&FileNode, FileGuid);
-  DevicePath = AppendDevicePathNode (DevicePathFromHandle (LoadedImage->DeviceHandle), (EFI_DEVICE_PATH_PROTOCOL *)&FileNode);
-  if (DevicePath == NULL) {
-    return;
-  }
-
-  Status = EfiBootManagerInitializeLoadOption (&Option, LoadOptionNumberUnassigned, LoadOptionTypeBoot, LOAD_OPTION_ACTIVE, Name, DevicePath, NULL, 0);
-  FreePool (DevicePath);
+  Image  = NULL;
+  Status = gBS->LoadImage (FALSE, gImageHandle, NULL, Buffer, Size, &Image);
+  FreePool (Buffer);
   if (EFI_ERROR (Status)) {
+    Print (L"piano: %s: LoadImage failed (%r)\n", Name, Status);
     return;
   }
 
-  EfiBootManagerBoot (&Option);
-  EfiBootManagerFreeLoadOption (&Option);
+  Print (L"piano: %s: starting\n", Name);
+  Status = gBS->StartImage (Image, NULL, NULL);
+  Print (L"piano: %s: returned (%r)\n", Name, Status);
 }
 
 STATIC
@@ -149,6 +162,13 @@ DeviceBootManagerAfterConsole ()
   PianoResetHookInstall ();
   PianoDtbInstall ();
   PianoFastbootStart ();
+
+  // UniXNU owns the boot menu when the board builds it into the volume: it
+  // publishes the payload volume, offers its entries and starts XNU. It only
+  // returns when it cannot run, so the ESP loader and Android stay as the
+  // fallbacks below.
+  StartFvApp (&mUniXNUFileGuid, L"UniXNU");
+
   StartEspLoader ();
 
   StartFvApp (&mAndroidBootFileGuid, L"Android");
