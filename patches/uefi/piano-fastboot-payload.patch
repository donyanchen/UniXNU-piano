+//
+// Publish the downloaded payload as a read-only block device. The FAT driver
+// picks it up from BlockIo and the boot menu can then read
+// \EFI\UniXNU\unixnu.toml out of it, which is what the boot image ramdisk was
+// supposed to provide: a vendor ABL refuses a ramdisk that large.
+//
+#define RAM_BLOCK_SIZE  512
+
+#pragma pack(1)
+typedef struct {
+  VENDOR_DEVICE_PATH        Vendor;
+  EFI_DEVICE_PATH_PROTOCOL  End;
+} RAM_VOLUME_DEVICE_PATH;
+#pragma pack()
+
+STATIC RAM_VOLUME_DEVICE_PATH  mVolumePath = {
+  {
+    { HARDWARE_DEVICE_PATH, HW_VENDOR_DP, { (UINT8)sizeof (VENDOR_DEVICE_PATH), (UINT8)(sizeof (VENDOR_DEVICE_PATH) >> 8) } },
+    { 0xA9C6827C, 0x1BD8, 0x410C, { 0x88, 0x5A, 0xC4, 0x65, 0x00, 0xF7, 0xD8, 0x36 } }
+  },
+  { END_DEVICE_PATH_TYPE, END_ENTIRE_DEVICE_PATH_SUBTYPE, { sizeof (EFI_DEVICE_PATH_PROTOCOL), 0 } }
+};
+
+STATIC UINT8                  *mVolumeBase;
+STATIC UINTN                  mVolumeBytes;
+STATIC EFI_BLOCK_IO_MEDIA     mVolumeMedia;
+STATIC EFI_BLOCK_IO_PROTOCOL  mVolumeIo;
+STATIC BOOLEAN                mVolumeReady;
+
+STATIC
+EFI_STATUS
+EFIAPI
+VolumeReset (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN BOOLEAN                ExtendedVerification
+  )
+{
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+VolumeRead (
+  IN  EFI_BLOCK_IO_PROTOCOL  *This,
+  IN  UINT32                 MediaId,
+  IN  EFI_LBA                Lba,
+  IN  UINTN                  BufferSize,
+  OUT VOID                   *Buffer
+  )
+{
+  if (Buffer == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  if (MediaId != mVolumeMedia.MediaId) {
+    return EFI_MEDIA_CHANGED;
+  }
+
+  if ((BufferSize % RAM_BLOCK_SIZE) != 0) {
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  if ((Lba > mVolumeMedia.LastBlock) || ((BufferSize / RAM_BLOCK_SIZE) > (mVolumeMedia.LastBlock + 1 - Lba))) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  CopyMem (Buffer, mVolumeBase + Lba * RAM_BLOCK_SIZE, BufferSize);
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+VolumeWrite (
+  IN EFI_BLOCK_IO_PROTOCOL  *This,
+  IN UINT32                 MediaId,
+  IN EFI_LBA                Lba,
+  IN UINTN                  BufferSize,
+  IN VOID                   *Buffer
+  )
+{
+  return EFI_WRITE_PROTECTED;
+}
+
+STATIC
+EFI_STATUS
+EFIAPI
+VolumeFlush (
+  IN EFI_BLOCK_IO_PROTOCOL  *This
+  )
+{
+  return EFI_SUCCESS;
+}
+
+STATIC
+EFI_STATUS
+PublishVolume (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  Handle;
+
+  if ((mData == NULL) || (mDataSize < RAM_BLOCK_SIZE)) {
+    return EFI_NOT_FOUND;
+  }
+
+  mVolumeBase   = (UINT8 *)mData;
+  mVolumeBytes  = mDataSize;
+
+  ZeroMem (&mVolumeMedia, sizeof (mVolumeMedia));
+  mVolumeMedia.MediaId          = 1;
+  mVolumeMedia.RemovableMedia   = FALSE;
+  mVolumeMedia.MediaPresent     = TRUE;
+  mVolumeMedia.LogicalPartition = FALSE;
+  mVolumeMedia.ReadOnly         = TRUE;
+  mVolumeMedia.WriteCaching     = FALSE;
+  mVolumeMedia.BlockSize        = RAM_BLOCK_SIZE;
+  mVolumeMedia.IoAlign          = 1;
+  mVolumeMedia.LastBlock        = mVolumeBytes / RAM_BLOCK_SIZE - 1;
+
+  mVolumeIo.Revision     = EFI_BLOCK_IO_PROTOCOL_REVISION;
+  mVolumeIo.Media        = &mVolumeMedia;
+  mVolumeIo.Reset        = VolumeReset;
+  mVolumeIo.ReadBlocks   = VolumeRead;
+  mVolumeIo.WriteBlocks  = VolumeWrite;
+  mVolumeIo.FlushBlocks  = VolumeFlush;
+
+  Handle = NULL;
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &Handle,
+                  &gEfiDevicePathProtocolGuid, &mVolumePath,
+                  &gEfiBlockIoProtocolGuid,    &mVolumeIo,
+                  NULL
+                  );
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  gBS->ConnectController (Handle, NULL, NULL, TRUE);
+  mVolumeReady = TRUE;
+  return EFI_SUCCESS;
+}
