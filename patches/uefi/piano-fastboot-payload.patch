+
+//
+// Give the host a window to hand the payload over before the boot menu scans
+// the volumes: the menu reads them once, so a payload published afterwards is
+// invisible to it. Returns TRUE when a volume arrived.
+//
+BOOLEAN
+PianoFastbootWaitPayload (
+  IN UINTN  TimeoutMs
+  )
+{
+  UINTN  Elapsed;
+
+  if (mVolumeReady) {
+    return TRUE;
+  }
+
+  Print (L"fastboot: waiting %u s for a payload (fastboot stage, then oem ramdisk)\n", (UINT32)(TimeoutMs / 1000));
+
+  for (Elapsed = 0; Elapsed < TimeoutMs; Elapsed += 100) {
+    if (mVolumeReady) {
+      Print (L"fastboot: payload volume published after %u ms\n", (UINT32)Elapsed);
+      return TRUE;
+    }
+
+    gBS->Stall (100000);
+  }
+
+  Print (L"fastboot: no payload arrived, continuing without one\n");
+  return mVolumeReady;
 }
